{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C: compilar archivo activo",
            "command": "gcc",
            "args": [
                "-std=c17",
                "-Wall",
                "-Wextra",
                "-pedantic",
                "-g",
                "${file}",
                "-lm",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "windows": {
                "args": [
                    "-std=c17",
                    "-Wall",
                    "-Wextra",
                    "-pedantic",
                    "-g",
                    "${file}",
                    "-lm",
                    "-o",
                    "${fileDirname}\\${fileBasenameNoExtension}.exe"
                ]
            },
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Requiere gcc en PATH. Enlaza libm para sistemas que la necesitan.",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "cppbuild",
            "label": "C++: compilar archivo activo",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-Wall",
                "-Wextra",
                "-pedantic",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "windows": {
                "args": [
                    "-std=c++17",
                    "-Wall",
                    "-Wextra",
                    "-pedantic",
                    "-g",
                    "${file}",
                    "-o",
                    "${fileDirname}\\${fileBasenameNoExtension}.exe"
                ]
            },
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "detail": "Requiere g++ en PATH.",
            "group": "build"
        },
        {
            "label": "C: ejecutar archivo activo",
            "type": "process",
            "command": "${fileDirname}/${fileBasenameNoExtension}",
            "windows": {
                "command": "${fileDirname}\\${fileBasenameNoExtension}.exe"
            },
            "dependsOn": "C: compilar archivo activo",
            "options": {
                "cwd": "${fileDirname}"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "C++: ejecutar archivo activo",
            "type": "process",
            "command": "${fileDirname}/${fileBasenameNoExtension}",
            "windows": {
                "command": "${fileDirname}\\${fileBasenameNoExtension}.exe"
            },
            "dependsOn": "C++: compilar archivo activo",
            "options": {
                "cwd": "${fileDirname}"
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "clear": false
            },
            "problemMatcher": []
        }
    ]
}
